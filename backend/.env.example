# Variables de entorno del backend. Es una referencia: Rails no lee este archivo ni un `.env`.
# Los valores por defecto de config/database.yml ya coinciden con docker-compose.yml, así que con
# `docker compose up -d db` no hace falta definir nada. Si tu MySQL es otro, exportá las que cambien
# antes de levantar Rails (por ejemplo `export DB_PORT=3307`).

# Conexión a MySQL (desarrollo y test).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gastoclaro
DB_PASSWORD=gastoclaro

# Origen (o lista separada por comas) desde el que el front puede llamar a la API (CORS).
# En desarrollo y test, si falta, se usa http://localhost:5173. En producción es obligatoria.
FRONTEND_URL=http://localhost:5173

# Casilla del equipo que recibe las consultas del formulario de soporte (mail por deliver_later).
# Si no se define, las consultas igual se guardan y el administrador las ve en la app.
SUPPORT_EMAIL=equipo@example.com
