xPoint x="430" y="320"/></Array></mxGeometry></mxCell><mxCell id="r21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0.2632;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8947;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_MovimientoRecurrente" target="e_Categoria"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="340"/><mxPoint x="480" y="340"/></Array></mxGeometry></mxCell><mxCell id="r22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0.1579;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.7895;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_Gasto" target="e_Tarjeta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="360"/><mxPoint x="1000" y="360"/></Array></mxGeometry></mxCell><mxCell id="r23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0.6842;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5585;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_Gasto" target="e_ResumenTarjeta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="215"/></Array></mxGeometry></mxCell><mxCell id="r24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0.1579;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7632;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_Ingreso" target="e_MovimientoRecurrente"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="770"/><mxPoint x="1265" y="770"/></Array></mxGeometry></mxCell><mxCell id="nota_subcat" value="&lt;b&gt;Subcategorías&lt;/b&gt;&lt;br&gt;Categoria se relaciona consigo misma (ej. Comida → Supermercado). En la base: parent_id opcional." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="150" width="270" height="80" as="geometry"/></mxCell><mxCell id="nota_regla" value="&lt;b&gt;Reglas de negocio&lt;/b&gt;&lt;br&gt;• Consumo = pago único (efectivo, débito o tarjeta en 1 cuota).&lt;br&gt;• Una compra en cuotas NO genera Consumo: sus Cuotas impactan el flujo de caja del mes de mesImputacion.&lt;br&gt;• AporteAhorro NO es un Consumo: Ingreso = Consumo + Ahorro (aportes).&lt;br&gt;• Saldo sin asignar = Ingresos − Consumos − Aportes.&lt;br&gt;• Avance de una meta = suma de sus aportes / montoObjetivo (se calcula, no se guarda).&lt;br&gt;• Presupuesto: de una categoría/subcategoría, o general del mes (sin categoría); uno por mes en cada caso. Real de una categoría padre = sus consumos + los de sus subcategorías (incluye Cuotas)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="1340" width="560" height="190" as="geometry"/></mxCell><mxCell id="e_MetaAhorro" value="MetaAhorro" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="850" y="1130" width="190" height="168" as="geometry"/></mxCell><mxCell id="a_MetaAhorro" value="ID&lt;br&gt;nombre&lt;br&gt;montoObjetivo&lt;br&gt;fechaObjetivo&lt;br&gt;activa" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;fontColor=#000000;" vertex="1" parent="e_MetaAhorro"><mxGeometry y="50" width="190" height="118" as="geometry"/></mxCell><mxCell id="e_AporteAhorro" value="AporteAhorro" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="1130" width="190" height="144" as="geometry"/></mxCell><mxCell id="a_AporteAhorro" value="ID&lt;br&gt;monto&lt;br&gt;fecha&lt;br&gt;descripcion" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;fontColor=#000000;" vertex="1" parent="e_AporteAhorro"><mxGeometry y="50" width="190" height="94" as="geometry"/></mxCell><mxCell id="r25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERone;endFill=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_MetaAhorro" target="e_Usuario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERone;endFill=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.6492;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_AporteAhorro" target="e_Usuario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#333333;strokeWidth=1.5;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0.0000;exitY=0.3475;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2976;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_AporteAhorro" target="e_MetaAhorro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel>